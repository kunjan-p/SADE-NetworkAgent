FROM kathara/pox:latest

# The PyPI `ovs` dependency used by Ryu can fall back to a pure-Python install
# on ARM64.  Debian's patched setuptools breaks that fallback, while newer
# setuptools releases are incompatible with Ryu's packaging hooks.  Overlay a
# compatible upstream setuptools release and keep builds out of isolation.
RUN apt-get update && \
    apt-get install -y --no-install-recommends stress-ng && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    python3.9 -m pip install --no-cache-dir --break-system-packages --ignore-installed \
        "pip==23.0.1" "setuptools==66.1.1" "wheel==0.38.4" && \
    python3.9 -m pip install --no-cache-dir --break-system-packages --no-build-isolation \
        ryu eventlet==0.30.2
